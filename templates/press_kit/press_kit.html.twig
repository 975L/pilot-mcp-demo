{# The press kit of a release card, laid out for Dompdf: a title page, then where the release stands #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ title }} - Press kit</title>
    <style>
        @page { margin: 0; }
        body { margin: 0; font-family: "DejaVu Serif", serif; color: #2b2118; }
        .cover { height: 297mm; background: #1f2a3a; color: #f6efe4; position: relative; page-break-after: always; }
        .cover-band { position: absolute; top: 0; left: 0; right: 0; height: 18mm; background: #8a4b2b; }
        .cover-kicker { position: absolute; top: 60mm; left: 22mm; right: 22mm; font-family: "DejaVu Sans", sans-serif; font-size: 11pt; letter-spacing: 3pt; text-transform: uppercase; color: #e0b083; }
        .cover-title { position: absolute; top: 72mm; left: 22mm; right: 22mm; font-size: 40pt; line-height: 1.1; }
        .cover-rule { position: absolute; top: 140mm; left: 22mm; width: 40mm; height: 1.2mm; background: #e0b083; }
        .cover-blurb { position: absolute; top: 150mm; left: 22mm; right: 30mm; font-size: 14pt; line-height: 1.5; font-style: italic; }
        .cover-facts { position: absolute; bottom: 28mm; left: 22mm; right: 22mm; font-family: "DejaVu Sans", sans-serif; font-size: 11pt; }
        .cover-facts td { padding: 2mm 8mm 2mm 0; vertical-align: top; }
        .cover-facts .label { color: #e0b083; text-transform: uppercase; letter-spacing: 1.5pt; font-size: 9pt; }
        .status { padding: 24mm 22mm; font-family: "DejaVu Sans", sans-serif; }
        .status h1 { font-family: "DejaVu Serif", serif; font-size: 22pt; margin: 0 0 2mm; color: #1f2a3a; }
        .status .sub { color: #8a4b2b; margin: 0 0 10mm; font-size: 10pt; text-transform: uppercase; letter-spacing: 2pt; }
        .status h2 { font-size: 11pt; text-transform: uppercase; letter-spacing: 1.5pt; color: #8a4b2b; border-bottom: 0.4mm solid #e0b083; padding-bottom: 1.5mm; margin: 8mm 0 3mm; }
        .status table { width: 100%; border-collapse: collapse; font-size: 11pt; }
        .status td { padding: 2.2mm 0; border-bottom: 0.2mm solid #eadfce; }
        .status .mark { width: 10mm; font-size: 13pt; }
        .status .done { color: #2f7d4f; }
        .status .todo { color: #b0413e; }
        .status .when { text-align: right; color: #7a6a58; font-size: 9pt; }
        .footer { position: absolute; bottom: 14mm; left: 22mm; right: 22mm; font-size: 8pt; color: #7a6a58; font-family: "DejaVu Sans", sans-serif; }
    </style>
</head>
<body>
    <div class="cover">
        <div class="cover-band"></div>
        <div class="cover-kicker">Press kit · New release</div>
        <div class="cover-title">{{ title }}</div>
        <div class="cover-rule"></div>
        <div class="cover-blurb">{{ blurb }}</div>
        <table class="cover-facts">
            <tr>
                <td><div class="label">Release date</div>{{ due ? due|date('F j, Y') : 'To be announced' }}</td>
                <td><div class="label">Formats</div>{{ formats ? formats|join(' · ') : 'To be announced' }}</td>
            </tr>
        </table>
    </div>

    <div class="status">
        <h1>{{ title }}</h1>
        <p class="sub">Where the release stands · {{ 'now'|date('F j, Y') }}</p>
        {# The steps under their group, ticked or not #}
        {% set group = null %}
        {% for step in steps %}
            {% if loop.first or (step.g ?? null) != group %}
                {% if not loop.first %}</table>{% endif %}
                {% set group = step.g ?? null %}
                <h2>{{ group ?? 'Steps' }}</h2>
                <table>
            {% endif %}
            <tr>
                <td class="mark {{ (step.done ?? false) ? 'done' : 'todo' }}">{{ (step.done ?? false) ? '✔' : '○' }}</td>
                <td>{{ step.t }}</td>
                <td class="when">{{ (step.done ?? false) and step.doneAt is defined ? step.doneAt|date('M j') ~ ((step.doneBy ?? null) ? ' · ' ~ step.doneBy : '') : 'to do' }}</td>
            </tr>
            {% if loop.last %}</table>{% endif %}
        {% endfor %}
        <div class="footer">{{ space }} · generated by the runner machine, no AI involved</div>
    </div>
</body>
</html>
